{
    "name":  "cloudflare-ops-mcp",
    "version":  "0.3.0",
    "description":  "-/\\-\\ M H // WT — OAuth-first Cloudflare Ops MCP with isolated per-user connections, DNS, Email Routing, DMARC, BIMI, Pages, cache, Turnstile, and dry-run fixes.",
    "type":  "module",
    "main":  "src/index.js",
    "exports":  {
                    ".":  "./src/index.js"
                },
    "bin":  {
                "cfops":  "./bin/cfops.js"
            },
    "scripts":  {
                    "test":  "node --test",
                    "worker:dev":  "cd worker \u0026\u0026 npx wrangler dev",
                    "worker:deploy":  "cd worker \u0026\u0026 npx wrangler deploy",
                    "worker:tail":  "cd worker \u0026\u0026 npx wrangler tail",
                    "worker:set-token":  "cd worker \u0026\u0026 npx wrangler secret put CLOUDFLARE_API_TOKEN",
                    "worker:set-key":  "cd worker \u0026\u0026 npx wrangler secret put MCP_ACCESS_KEY",
                    "registry:validate":  "mcp-publisher validate",
                    "worker:generate-key":  "node scripts/generate-mcp-key.mjs",
                    "oauth:setup":  "node scripts/oauth-setup.mjs",
                    "worker:set-oauth":  "cd worker \u0026\u0026 npx wrangler secret put CLOUDFLARE_OAUTH_CLIENT_ID \u0026\u0026 npx wrangler secret put CLOUDFLARE_OAUTH_CLIENT_SECRET \u0026\u0026 npx wrangler secret put CLOUDFLARE_OAUTH_REDIRECT_URI",
                    "oauth:create":  "node scripts/cloudflare-oauth-create.mjs",
                    "oauth:create:deploy":  "node scripts/cloudflare-oauth-create.mjs %CLOUDFLARE_ACCOUNT_ID% %CLOUDFLARE_OPS_WORKER_ORIGIN% --deploy"
                },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "keywords":  [
                     "cloudflare-email-auth",
                     "cloudflare-mcp",
                     "cloudflare-dns-mcp",
                     "cloudflare",
                     "wrangler",
                     "mcp-server",
                     "model-context-protocol",
                     "ai-agent",
                     "dns",
                     "dns-management",
                     "dmarc",
                     "bimi",
                     "spf",
                     "dkim",
                     "email-routing",
                     "email-authentication",
                     "cloudflare-api",
                     "workers",
                     "cloudflare-workers",
                     "zone-fixer",
                     "approval-gated",
                     "cloudflare-ops",
                     "cloudflare-pages",
                     "cloudflare-cache",
                     "cloudflare-turnstile",
                     "turnstile",
                     "cache-purge",
                     "pages-deployment"
                 ],
    "author":  "AMH - Artificial Mind Hive (Service Pricer LLC)",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/pain2hustle/cloudflare-ops-mcp.git"
                   },
    "homepage":  "https://cfops.nothingunseen.com",
    "bugs":  {
                 "url":  "https://github.com/pain2hustle/cloudflare-ops-mcp/issues"
             },
    "files":  [
                  "src",
                  "bin",
                  "worker/index.js",
                  "worker/oauth.js",
                  "assets/wt-walrus.png",
                  "worker/wrangler.jsonc",
                  "README.md",
                  "MCP.md",
                  "llms.txt",
                  "server.json",
                  "LICENSE",
                  "scripts/generate-mcp-key.mjs",
                  "SETUP.md",
                  "PHASES.md",
                  "OAUTH.md",
                  "ROADMAP.md",
                  "SECURITY.md",
                  "scripts/oauth-setup.mjs",
                  "scripts/cloudflare-oauth-create.mjs"
              ],
    "mcpName":  "io.github.pain2hustle/cloudflare-ops-mcp",
    "funding":  {
                    "type":  "custom",
                    "url":  "https://servicepricer.app"
                }
}

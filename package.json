{
  "name": "cloudflare-ops-mcp",
  "version": "0.4.0",
  "description": "AMH WT Cloudflare Ops MCP v0.4: OAuth-isolated Cloudflare tools plus a private SafeTry Agent Harness for bounded research, independent verification, deterministic health checks, schedules, audit, live operator console, and verified deploy gates across DNS, email, Pages, cache, Turnstile, Wrangler, and official Cloudflare MCP connectors.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "cfops": "./bin/cfops.js"
  },
  "scripts": {
    "test": "node --test",
    "worker:dev": "cd worker && npx wrangler dev",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "worker:tail": "cd worker && npx wrangler tail",
    "worker:set-token": "cd worker && npx wrangler secret put CLOUDFLARE_API_TOKEN",
    "worker:set-key": "cd worker && npx wrangler secret put MCP_ACCESS_KEY",
    "registry:validate": "mcp-publisher validate",
    "worker:generate-key": "node scripts/generate-mcp-key.mjs",
    "oauth:setup": "node scripts/oauth-setup.mjs",
    "worker:set-oauth": "cd worker && npx wrangler secret put CLOUDFLARE_OAUTH_CLIENT_ID && npx wrangler secret put CLOUDFLARE_OAUTH_CLIENT_SECRET && npx wrangler secret put CLOUDFLARE_OAUTH_REDIRECT_URI",
    "oauth:create": "node scripts/cloudflare-oauth-create.mjs",
    "oauth:create:deploy": "node scripts/cloudflare-oauth-create.mjs %CLOUDFLARE_ACCOUNT_ID% %CLOUDFLARE_OPS_WORKER_ORIGIN% --deploy",
    "verify:live": "node scripts/verify-live.mjs",
    "worker:deploy:verified": "node scripts/deploy-verified.mjs --dir worker --url https://cfops.nothingunseen.com/?format=json --expect 0.4.0",
    "agent:deploy:verified": "node scripts/deploy-verified.mjs --dir agent --url auto --path /health --expect 0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudflare-email-auth",
    "cloudflare-mcp",
    "cloudflare-dns-mcp",
    "cloudflare",
    "wrangler",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "dns",
    "dns-management",
    "dmarc",
    "bimi",
    "spf",
    "dkim",
    "email-routing",
    "email-authentication",
    "cloudflare-api",
    "workers",
    "cloudflare-workers",
    "zone-fixer",
    "approval-gated",
    "cloudflare-ops",
    "cloudflare-pages",
    "cloudflare-cache",
    "cloudflare-turnstile",
    "turnstile",
    "cache-purge",
    "pages-deployment"
  ],
  "author": "AMH - Artificial Mind Hive (Service Pricer LLC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pain2hustle/cloudflare-ops-mcp.git"
  },
  "homepage": "https://cfops.nothingunseen.com",
  "bugs": {
    "url": "https://github.com/pain2hustle/cloudflare-ops-mcp/issues"
  },
  "files": [
    "src",
    "bin",
    "worker/index.js",
    "worker/oauth.js",
    "assets/wt-walrus.png",
    "assets/WT WALRUS TOOTH.png",
    "worker/wrangler.jsonc",
    "README.md",
    "MCP.md",
    "llms.txt",
    "server.json",
    "LICENSE",
    "scripts/generate-mcp-key.mjs",
    "SETUP.md",
    "PHASES.md",
    "OAUTH.md",
    "ROADMAP.md",
    "SECURITY.md",
    "PRIVACY.md",
    "TERMS.md",
    "scripts/oauth-setup.mjs",
    "scripts/cloudflare-oauth-create.mjs",
    "scripts/verify-live.mjs",
    "scripts/deploy-verified.mjs",
    "AGENT-HARNESS.md",
    "CLOUDFLARE-MCP.md",
    "GIT-INTEGRATION.md",
    "MAIL-LANDING-GUIDE.md",
    "RELEASE-GATE.md",
    "agent/package.json",
    "agent/wrangler.jsonc",
    "agent/.dev.vars.example",
    "agent/src",
    "agent/scripts/watch.mjs",
    "agent/knowledge-vault/README.md"
  ],
  "mcpName": "io.github.pain2hustle/cloudflare-ops-mcp",
  "funding": {
    "type": "custom",
    "url": "https://servicepricer.app"
  }
}

{
    "$schema":  "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name":  "io.github.pain2hustle/cloudflare-ops-mcp",
    "title":  "AMH Cloudflare Ops MCP by WT",
    "description":  "OAuth-first Cloudflare Ops MCP with isolated per-user Cloudflare connections and approval-gated DNS, Email Routing, DMARC/SPF/BIMI, Pages, cache, and Turnstile tools.",
    "version":  "0.3.0",
    "repository":  {
                       "url":  "https://github.com/pain2hustle/cloudflare-ops-mcp",
                       "source":  "github"
                   },
    "remotes":  [
                    {
                        "type":  "streamable-http",
                        "url":  "https://cfops.nothingunseen.com/mcp",
                        "headers":  [
                                        {
                                            "name":  "Authorization",
                                            "description":  "Your one-user cfops_ connector key, issued after Cloudflare OAuth. This is not a Cloudflare API token.",
                                            "isRequired":  true,
                                            "isSecret":  true
                                        }
                                    ]
                    }
                ],
    "packages":  [
                     {
                         "registryType":  "npm",
                         "identifier":  "cloudflare-ops-mcp",
                         "version":  "0.3.0",
                         "transport":  {
                                           "type":  "stdio"
                                       },
                         "environmentVariables":  [
                                                      {
                                                          "name":  "CLOUDFLARE_API_TOKEN",
                                                          "description":  "Scoped Cloudflare API token with only the permissions needed for the tools you use, such as Zone Read, DNS Edit, Email Routing Rules Edit, Cache Purge, and Turnstile Edit. Never use a Global API Key.",
                                                          "isRequired":  true,
                                                          "format":  "string",
                                                          "isSecret":  true
                                                      }
                                                  ]
                     }
                 ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ops-mcp",
  "main": "index.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "mcp.artificialmindhive.com", "custom_domain": true }
  ],
  // 🚨 TWO DEPLOYMENTS EXIST — do NOT "fix" a 10041 KV error by creating a new
  // namespace. That KV holds the OAuth grants and every issued cfops_ connector
  // key; a fresh namespace WIPES them.
  //   AMH  (canonical, this file): account 0ebf6d65… pain2hustle1
  //        mcp.artificialmindhive.com   KV 4d55e8a9a8c54d9d8e03253542e0dbdb
  //   Legacy Austin deployment (un-routed): account 1d5fae60… austinsdoors1
  //        KV 1854b6d5bc8c4860bc914412443a0172
  //        (that KV is still TITLED ZONEMENDER_OAUTH from before the rename)
  // Deploying this file to austinsdoors1 fails on both the KV id and the custom
  // domain (that zone lives in the other account). Target it explicitly.
  "kv_namespaces": [
    { "binding": "CLOUDFLARE_OPS_OAUTH", "id": "4d55e8a9a8c54d9d8e03253542e0dbdb" }
  ],
  // Native Workers Rate Limiting (GA 2025-09). Backed by the same engine as WAF
  // rate limiting rules. namespace_id is any integer unique to this account.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMITER_ADMIN", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "services": [
    { "binding": "AGENT_HARNESS", "service": "amh-wt-agent-harness" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
  // OAuth secrets for hosted connectors:
  //   npx wrangler secret put CLOUDFLARE_OAUTH_CLIENT_ID
  //   npx wrangler secret put CLOUDFLARE_OAUTH_CLIENT_SECRET
  //   npx wrangler secret put CLOUDFLARE_OAUTH_REDIRECT_URI
  // Optional var/secret: CLOUDFLARE_OAUTH_SCOPES
  // Private owner fallback secrets (optional; never vars, never in git):
  //   cd worker
  //   npx wrangler secret put CLOUDFLARE_API_TOKEN   # scoped CF token the tools use
  //   npx wrangler secret put MCP_ACCESS_KEY         # private owner/admin key
  //   npx wrangler secret put HARNESS_INTERNAL_KEY   # same random value on harness
  // Public users connect at /oauth/cloudflare/start and receive an isolated
  // cfops_ connector key. The Cloudflare OAuth token stays encrypted at rest in KV.
  // Deploy:
  //   npx wrangler deploy
}
